# Copy this file to .env in the repository root and fill in your own key.
# .env is in .gitignore; keys never go in the repository or in the web app.

# Meta Model API (Muse Spark 1.3, SAM 3.1, Muse Image 1.0). Needed only for live runs.
# Replaying the recorded demo runs needs no key.
MODEL_API_KEY=

# Rebuilding the catalog tags with Muse Spark Open (catalog/modal_catalog.py --step tag) reads
# BASETEN_API_KEY and FIREWORKS_API_KEY from a Modal secret named realroom-keys, not from this file.
# The hosted app (backend/modal_app.py) reads MODEL_API_KEY from a separate Modal secret named
# realroom-model that holds that key and nothing else.
